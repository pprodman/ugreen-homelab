#==============================================================================
# 🌍 CONFIGURACIÓN GLOBAL - HOMELAB BEARSLIONS
#==============================================================================

# Este archivo reside en la raíz de /gitops/ y es inyectado en cada stack.

# Cambiar un valor aquí actualiza toda la infraestructura.

# --- IDENTIDAD DEL SISTEMA (NAS Ugreen DXP2800) ---

PUID=1000
PGID=100
TZ=Europe/Madrid
USER_NAME=pprodman

# --- NETWORKING & DOMINIOS ---

DOMAIN=bearslions.com
NAS_IP=192.168.1.225
ROUTER_IP=192.168.1.1

# --- RUTAS MAESTRAS (Crucial para separar GitOps de AppData) ---

# Usamos rutas absolutas para evitar errores de contexto en Dockhand.

DOCKER_ROOT=/volume2/docker
GITOPS_PATH=/volume2/docker/gitops
APPDATA_PATH=/volume2/docker/appdata

# --- OPTIMIZACIÓN DE RECURSOS (Perfil Intel N100 - 8GB RAM) ---

# Limitamos los logs globalmente para que no saturen el almacenamiento HDD.

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- CREDENCIALES COMPARTIDAS (OPCIONAL/EJEMPLO) ---

# Solo variables que no sean críticas. Las contraseñas reales van en el .env

# específico de cada stack o en el gestor de secretos de Dockhand.

CLOUDFLARE_EMAIL=tu-email@ejemplo.com